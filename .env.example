APP_ENV=development
DATABASE_URL=postgresql://amrutam:amrutam_dev_only@db:5432/amrutam
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-32-byte-random-secret-before-deploy
# Optional in development; production must use a secret manager and set both keys.
# PHI_ENCRYPTION_KEYS is comma-separated with the active Fernet key first during rotation.
# EMAIL_LOOKUP_KEY must be a separate random secret of at least 32 characters.
PHI_ENCRYPTION_KEYS=
EMAIL_LOOKUP_KEY=
JWT_ISSUER=amrutam-api
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=http://localhost:3000
